<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Crowbar"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Crowbar.MainWindow"
        Title=""
        Width="1280" Height="800"
        WindowDecorations="Full"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="#18181B"
        Foreground="#E4E4E7">

    <Window.Styles>
        <Style Selector="MenuItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="9,4"/>
        </Style>
        <Style Selector="MenuItem.title-menu-item">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BackgroundSizing" Value="InnerBorderEdge"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style Selector="MenuItem.title-menu-item:pointerover">
            <Setter Property="Background" Value="#3F3F46"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BackgroundSizing" Value="InnerBorderEdge"/>
        </Style>
        <Style Selector="ToggleButton">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BackgroundSizing" Value="InnerBorderEdge"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, Auto, *, 160, Auto">

        <!-- 1. Custom titlebar: menus share the same row as the window controls. -->
        <Border Grid.Row="0" Background="#1F1F1F" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, *" Height="32" Margin="0,0,138,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" Padding="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="◆" Foreground="#60A5FA" FontSize="10" VerticalAlignment="Center"/>
                    </Border>
                    <Menu Background="Transparent" Height="32" VerticalAlignment="Center">
                        <MenuItem Classes="title-menu-item" Header="_File">
                            <MenuItem Header="_New Scene" Click="OnNewSceneClick"/>
                            <Separator/>
                            <MenuItem Header="_Exit" Click="OnExitClick"/>
                        </MenuItem>
                        <MenuItem Classes="title-menu-item" Header="_Edit">
                            <MenuItem Header="_Duplicate"/>
                            <MenuItem Header="_Delete" Click="OnDeleteObjectClick"/>
                        </MenuItem>
                        <MenuItem Classes="title-menu-item" Header="_GameObject">
                            <MenuItem Header="3D Object > Cube" Click="OnAddCubeClick"/>
                            <MenuItem Header="3D Object > Pyramid" Click="OnAddPyramidClick"/>
                        </MenuItem>
                        <MenuItem Classes="title-menu-item" Header="_Window">
                            <MenuItem Header="Reset Viewport Camera" Click="OnResetCameraClick"/>
                        </MenuItem>
                        <MenuItem Classes="title-menu-item" Header="_Help">
                            <MenuItem Header="About Engine"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
                <Grid x:Name="TitleBarDragArea" Grid.Column="1" Background="Transparent"
                      chrome:WindowDecorationProperties.ElementRole="TitleBar"
                      PointerPressed="OnTitleBarPointerPressed">
                    <TextBlock Text="Crowbar Engine" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="12" Foreground="#D4D4D8" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. Main Toolbar -->
        <Border Grid.Row="1" Background="#202023" BorderBrush="#3F3F46" BorderThickness="0,1,0,1" Padding="8,4">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                    <Border CornerRadius="6" ClipToBounds="True">
                        <Button Content="▶ Play" x:Name="BtnPlay" Click="OnTogglePlayClick" Background="#2563EB" Foreground="White" Padding="12,4" FontWeight="SemiBold"/>
                    </Border>
                    <Border CornerRadius="6" ClipToBounds="True">
                        <ToggleButton Content="🌐 Wireframe" IsChecked="{Binding Scene.IsWireframe, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Padding="8,4"/>
                    </Border>
                    <Border CornerRadius="6" ClipToBounds="True">
                        <Button Content="🎥 Reset Camera" Click="OnResetCameraClick" Padding="8,4"/>
                    </Border>
                    <Separator Width="1" Height="20" Background="#3F3F46" Margin="4,0"/>
                    <Border CornerRadius="6" ClipToBounds="True">
                        <Button Content="+ Add Cube" Click="OnAddCubeClick" Padding="8,4"/>
                    </Border>
                    <Border CornerRadius="6" ClipToBounds="True">
                        <Button Content="+ Add Pyramid" Click="OnAddPyramidClick" Padding="8,4"/>
                    </Border>
                    <Border CornerRadius="6" ClipToBounds="True">
                        <Button Content="🗑 Remove" Click="OnDeleteObjectClick" Padding="8,4"/>
                    </Border>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding #Viewport.Fps, StringFormat='FPS: {0}'}" FontSize="11" Foreground="#4ADE80" FontWeight="Bold"/>
                    <TextBlock Text="{Binding #Viewport.FrameTimeMs, StringFormat='{}{0:F1} ms'}" FontSize="11" Foreground="#A1A1AA"/>
                    <Border Background="#27272A" Padding="6,2" CornerRadius="4">
                        <TextBlock Text="WebGPU (WGPU)" FontSize="11" Foreground="#60A5FA" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. Main Workspace (Hierarchy | Viewport | Inspector) -->
        <Grid Grid.Row="2" ColumnDefinitions="260, 4, *, 4, 300">

            <!-- Left: Scene Hierarchy Panel -->
            <Border Grid.Column="0" Background="#1F1F23" BorderBrush="#27272A" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto, *">
                    <Border Grid.Row="0" Background="#27272A" Padding="10,6">
                        <TextBlock Text="HIERARCHY" FontWeight="Bold" FontSize="11" Foreground="#A1A1AA" LetterSpacing="1"/>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Scene.Objects, RelativeSource={RelativeSource AncestorType=local:MainWindow}}"
                             SelectedItem="{Binding Scene.SelectedObject, RelativeSource={RelativeSource AncestorType=local:MainWindow}, Mode=TwoWay}"
                             Background="Transparent" Margin="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:SceneObject">
                                <Border Padding="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="📦" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="Medium"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Splitter 1 -->
            <GridSplitter Grid.Column="1" Background="#27272A" ResizeDirection="Columns"/>

            <!-- Center: Viewport Panel with Silk.NET Render Control -->
            <Grid Grid.Column="2" Background="Transparent"
                  Focusable="True"
                  PointerPressed="OnViewportPointerPressed"
                  PointerMoved="OnViewportPointerMoved"
                  PointerReleased="OnViewportPointerReleased"
                  PointerWheelChanged="OnViewportPointerWheelChanged">
                <local:SilkViewportControl x:Name="Viewport" Scene="{Binding Scene, RelativeSource={RelativeSource AncestorType=local:MainWindow}}"/>

                <!-- HUD / Viewport Overlay -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="8,6" Background="#CC18181B" CornerRadius="6" IsHitTestVisible="False">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Silk.NET WebGPU Viewport" FontWeight="Bold" FontSize="11" Foreground="#60A5FA"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                            <TextBlock Text="{Binding #Viewport.Fps, StringFormat='FPS: {0}'}" FontSize="11" Foreground="#4ADE80" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding #Viewport.FrameTimeMs, StringFormat='Frame: {0:F1} ms'}" FontSize="11" Foreground="#A1A1AA"/>
                        </StackPanel>
                        <TextBlock Text="{Binding #Viewport.GpuVendor, StringFormat='GPU: {0}'}" FontSize="10" Foreground="#71717A"/>
                        <TextBlock Text="{Binding #Viewport.GpuRenderer, StringFormat='Renderer: {0}'}" FontSize="10" Foreground="#71717A"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Controls Help Overlay -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Padding="8,4" Background="#AA18181B" CornerRadius="4" IsHitTestVisible="False">
                    <TextBlock Text="LMB / RMB Drag: Orbit | MMB Drag: Pan | Scroll: Zoom" FontSize="10" Foreground="#A1A1AA"/>
                </Border>
            </Grid>

            <!-- Splitter 2 -->
            <GridSplitter Grid.Column="3" Background="#27272A" ResizeDirection="Columns"/>

            <!-- Right: Inspector Panel -->
            <Border Grid.Column="4" Background="#1F1F23" BorderBrush="#27272A" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto, *">
                    <Border Grid.Row="0" Background="#27272A" Padding="10,6">
                        <TextBlock Text="INSPECTOR" FontWeight="Bold" FontSize="11" Foreground="#A1A1AA" LetterSpacing="1"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" Padding="12">
                        <StackPanel Spacing="12" DataContext="{Binding Scene.SelectedObject, RelativeSource={RelativeSource AncestorType=local:MainWindow}}">
                            <StackPanel.Styles>
                                <Style Selector="TextBlock.Header">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                </Style>
                                <Style Selector="TextBlock.Label">
                                    <Setter Property="Width" Value="24"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </StackPanel.Styles>

                            <!-- Name Header -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Object Name" Classes="Header"/>
                                <TextBox Text="{Binding Name, Mode=TwoWay}"/>
                            </StackPanel>

                            <Separator Background="#27272A"/>

                            <!-- Transform Section -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="TRANSFORM" Classes="Header"/>

                                <!-- Position -->
                                <TextBlock Text="Position" FontSize="11" Foreground="#6B7280"/>
                                <Grid ColumnDefinitions="*, *, *">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,4,0">
                                        <TextBlock Text="X" Classes="Label" Foreground="#EF4444"/>
                                        <NumericUpDown Value="{Binding PositionX, Mode=TwoWay}" Increment="0.1" FormatString="F2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="2,0,2,0">
                                        <TextBlock Text="Y" Classes="Label" Foreground="#10B981"/>
                                        <NumericUpDown Value="{Binding PositionY, Mode=TwoWay}" Increment="0.1" FormatString="F2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                                        <TextBlock Text="Z" Classes="Label" Foreground="#3B82F6"/>
                                        <NumericUpDown Value="{Binding PositionZ, Mode=TwoWay}" Increment="0.1" FormatString="F2"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Rotation -->
                                <TextBlock Text="Rotation (Degrees)" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                                <Grid ColumnDefinitions="*, *, *">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,4,0">
                                        <TextBlock Text="X" Classes="Label" Foreground="#EF4444"/>
                                        <NumericUpDown Value="{Binding RotationX, Mode=TwoWay}" Increment="5.0" FormatString="F1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="2,0,2,0">
                                        <TextBlock Text="Y" Classes="Label" Foreground="#10B981"/>
                                        <NumericUpDown Value="{Binding RotationY, Mode=TwoWay}" Increment="5.0" FormatString="F1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                                        <TextBlock Text="Z" Classes="Label" Foreground="#3B82F6"/>
                                        <NumericUpDown Value="{Binding RotationZ, Mode=TwoWay}" Increment="5.0" FormatString="F1"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Scale -->
                                <TextBlock Text="Scale" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                                <Grid ColumnDefinitions="*, *, *">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,4,0">
                                        <TextBlock Text="X" Classes="Label" Foreground="#EF4444"/>
                                        <NumericUpDown Value="{Binding ScaleX, Mode=TwoWay}" Increment="0.1" FormatString="F2" Minimum="0.01"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="2,0,2,0">
                                        <TextBlock Text="Y" Classes="Label" Foreground="#10B981"/>
                                        <NumericUpDown Value="{Binding ScaleY, Mode=TwoWay}" Increment="0.1" FormatString="F2" Minimum="0.01"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                                        <TextBlock Text="Z" Classes="Label" Foreground="#3B82F6"/>
                                        <NumericUpDown Value="{Binding ScaleZ, Mode=TwoWay}" Increment="0.1" FormatString="F2" Minimum="0.01"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Separator Background="#27272A"/>

                            <!-- Material / Mesh Section -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="MATERIAL &amp; COLOR" Classes="Header"/>
                                <Grid ColumnDefinitions="*, *">
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Red" FontSize="11"/>
                                        <Slider Value="{Binding ColorR, Mode=TwoWay}" Minimum="0" Maximum="1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Green" FontSize="11"/>
                                        <Slider Value="{Binding ColorG, Mode=TwoWay}" Minimum="0" Maximum="1"/>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*, *">
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Blue" FontSize="11"/>
                                        <Slider Value="{Binding ColorB, Mode=TwoWay}" Minimum="0" Maximum="1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Alpha" FontSize="11"/>
                                        <Slider Value="{Binding ColorA, Mode=TwoWay}" Minimum="0" Maximum="1"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="Is Visible" IsChecked="{Binding IsVisible, Mode=TwoWay}"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>

        <!-- 4. Bottom Panel (Console / Assets TabControl) -->
        <Border Grid.Row="3" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,1,0,0">
            <TabControl Padding="0">
                <TabItem Header="Console">
                    <TextBox x:Name="TxtConsole" IsReadOnly="True" AcceptsReturn="True"
                             Background="#121214" Foreground="#A1A1AA" FontFamily="Consolas, Courier New"
                             Margin="4" CornerRadius="4"/>
                </TabItem>
                <TabItem Header="Project Assets">
                    <Border Padding="12" Background="#121214" Margin="4" CornerRadius="4">
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Width="70" Margin="8" HorizontalAlignment="Center">
                                <TextBlock Text="📁" FontSize="32" HorizontalAlignment="Center"/>
                                <TextBlock Text="Shaders" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Width="70" Margin="8" HorizontalAlignment="Center">
                                <TextBlock Text="📁" FontSize="32" HorizontalAlignment="Center"/>
                                <TextBlock Text="Textures" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Width="70" Margin="8" HorizontalAlignment="Center">
                                <TextBlock Text="🧊" FontSize="32" HorizontalAlignment="Center"/>
                                <TextBlock Text="Cube.obj" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Border>

        <!-- 5. Status Bar -->
        <Border Grid.Row="4" Background="#09090B" Padding="8,2">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <TextBlock Grid.Column="0" Text="● Engine Ready" FontSize="10" Foreground="#22C55E"/>
                <TextBlock Grid.Column="1" Text="{Binding Scene.SelectedObject.Name, StringFormat='Selected: {0}', RelativeSource={RelativeSource AncestorType=local:MainWindow}}"
                           FontSize="10" Foreground="#A1A1AA" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Avalonia 12 + Silk.NET 2.23 (WGPU)" FontSize="10" Foreground="#71717A"/>
            </Grid>
        </Border>

    </Grid>
</Window>
