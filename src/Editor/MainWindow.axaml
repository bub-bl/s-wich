<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Crowbar"
        xmlns:editor="clr-namespace:Crowbar.Editor"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Crowbar.Editor.MainWindow"
        x:Name="RootWindow"
        Title=""
        Width="1280" Height="800"
        WindowDecorations="Full"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="#18181B"
        Foreground="#E4E4E7">

    <Window.Styles>
        <Style Selector="MenuItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="9,4"/>
        </Style>
        <Style Selector="MenuItem.title-menu-item">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BackgroundSizing" Value="InnerBorderEdge"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style Selector="MenuItem.title-menu-item:pointerover">
            <Setter Property="Background" Value="#3F3F46"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BackgroundSizing" Value="InnerBorderEdge"/>
        </Style>
        <Style Selector="ToggleButton">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BackgroundSizing" Value="InnerBorderEdge"/>
        </Style>
        <Style Selector="ToggleButton.drawer-tab">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,3"/>
        </Style>
        <Style Selector="ToggleButton.drawer-tab:pointerover">
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
        </Style>
        <Style Selector="ToggleButton.drawer-tab:checked">
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, Auto, *, 0, Auto">

        <!-- 1. Custom titlebar: menus share the same row as the window controls. -->
        <editor:TitleBar Grid.Row="0" x:Name="TitleBar"
                         ActionRequested="OnTitleBarAction"
                         DragAreaPointerPressed="OnTitleBarPointerPressed"/>

        <!-- 2. Main Toolbar -->
        <editor:Toolbar x:Name="Toolbar" Grid.Row="1"/>

        <!-- 3. Main Workspace (Hierarchy | Viewport | Inspector) -->
        <Grid Grid.Row="2" ColumnDefinitions="260, 4, *, 4, 300">

            <!-- Left: Scene Hierarchy Panel -->
            <editor:HierarchyPanel x:Name="Hierarchy" Grid.Column="0"/>

            <!-- Splitter 1 -->
            <GridSplitter Grid.Column="1" Background="#27272A" ResizeDirection="Columns"/>

            <!-- Center: Viewport Panel with Silk.NET Render Control -->
            <Grid Grid.Column="2" Background="Transparent"
                  Focusable="True"
                  PointerPressed="OnViewportPointerPressed"
                  PointerMoved="OnViewportPointerMoved"
                  PointerReleased="OnViewportPointerReleased"
                  PointerWheelChanged="OnViewportPointerWheelChanged">
                <editor:SilkViewportControl x:Name="Viewport" Scene="{Binding Scene, RelativeSource={RelativeSource AncestorType=editor:MainWindow}}"/>

                <!-- HUD / Viewport Overlay -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="8,6" Background="#CC18181B" CornerRadius="6" IsHitTestVisible="False">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Silk.NET WebGPU Viewport" FontWeight="Bold" FontSize="11" Foreground="#60A5FA"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                            <TextBlock Text="{Binding #Viewport.Fps, StringFormat='FPS: {0}'}" FontSize="11" Foreground="#4ADE80" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding #Viewport.FrameTimeMs, StringFormat='Frame: {0:F1} ms'}" FontSize="11" Foreground="#A1A1AA"/>
                        </StackPanel>
                        <TextBlock Text="{Binding #Viewport.GpuVendor, StringFormat='GPU: {0}'}" FontSize="10" Foreground="#71717A"/>
                        <TextBlock Text="{Binding #Viewport.GpuRenderer, StringFormat='Renderer: {0}'}" FontSize="10" Foreground="#71717A"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Controls Help Overlay -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Padding="8,4" Background="#AA18181B" CornerRadius="4" IsHitTestVisible="False">
                    <TextBlock Text="LMB / RMB Drag: Look | MMB Drag: Pan | Scroll: Move" FontSize="10" Foreground="#A1A1AA"/>
                </Border>
            </Grid>

            <!-- Splitter 2 -->
            <GridSplitter Grid.Column="3" Background="#27272A" ResizeDirection="Columns"/>

            <!-- Right: Inspector Panel -->
            <editor:InspectorPanel x:Name="Inspector" Grid.Column="4"/>

        </Grid>

        <!-- 4. Status Bar -->
        <editor:StatusBar Grid.Row="4"/>

        <!-- Console and Project Assets drawer: opened from the bottom with Space, like UE5. -->
        <editor:AssetsDrawer x:Name="AssetsDrawerControl" Grid.Row="0" Grid.RowSpan="5"/>

    </Grid>
</Window>
