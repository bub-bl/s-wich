<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Crowbar.Editor</AssemblyName>
    <RootNamespace>Crowbar.Editor</RootNamespace>
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
    <UseRazorSourceGenerator>false</UseRazorSourceGenerator>
    <EnableDefaultRazorComponentItems>false</EnableDefaultRazorComponentItems>
    <RazorLangVersion>Latest</RazorLangVersion>
    <ScopedCssEnabled>false</ScopedCssEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine\Engine.csproj" />
    <Content Update="Ui\**\*.razor" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Ui\**\*.css" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Ui\Components\MyButton.razor.css">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <DependentUpon>MyButton.razor</DependentUpon>
    </None>
  </ItemGroup>

  <!-- Provides the standard Razor component reference surface to the IDE.
       The runtime compiler remains custom and does not use ASP.NET rendering. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

    <!--
      Keep the custom runtime compiler authoritative during normal builds. The
      Razor SDK still receives the files during design-time builds, which gives
      IDEs a generated declaration/context for completion and diagnostics.
    -->
  <ItemGroup>
    <RazorComponent Include="Ui\**\*.razor" />
  </ItemGroup>

  <!-- The IDE keeps the RazorComponent item for language services. During a
       normal build remove it before the Razor SDK resolves its inputs; the
       runtime RazorComponentFactory remains the actual compiler. -->
  <Target Name="CrowbarDisableRazorBuildItems"
          BeforeTargets="ResolveRazorComponentInputs"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <RazorComponent Remove="Ui\**\*.razor" />
    </ItemGroup>
  </Target>
</Project>
