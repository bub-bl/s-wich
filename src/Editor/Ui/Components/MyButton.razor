@inherits Crowbar.Engine.UI.RazorPanel
@namespace Crowbar.Editor.Ui.Components
@using Microsoft.AspNetCore.Components

<div class="btn">
    <div class="title">My text: @Value</div>
</div>

@code {

    // The standard attribute exposes this property to Razor language services;
    // the custom attribute keeps the native runtime parameter validation.
    [Parameter]
    [Engine.UI.Parameter]
    public string Value { get; set; } = string.Empty;

    protected override int BuildHash() => HashCode.Combine(Value);
    
}
