@page "/"
@page "/demo"
@inherits Crowbar.UI.RazorPanel
@using System
@using System.Text
@namespace Crowbar.Editor.Ui

@{ var pipelineLabel = new StringBuilder("Rendered by RazorPanel + Skia").ToString(); }

<div class="card">
    <div class="title">Crowbar Razor UI</div>
    <div class="subtitle">Razor + Yoga + Skia + WebGPU</div>

    <div class="separator"></div>

    <div class="row">
        <button class="action" @onclick="@Increment">CLICKED @_count TIMES</button>
        <div class="status">SCREEN PANEL ACTIVE · RENDER @_renderCount</div>
    </div>

    @if (_count > 0)
    {
        <div class="status">LAST ACTION REGISTERED</div>
    }

    <MyButton Value="Salut mec"></MyButton>
    <MyButton Value="Salut mec"></MyButton>
    <MyButton Value="Salut mec"></MyButton>
    
    <Card>
        <div class="field-label">INPUT FIELD (ChildContent)</div>
        <input class="field" value="@_name" @bind-value="_name"/>
        <div class="status">@_name</div>
    </Card>

    <Panel>
        <Header>
            <div class="panel-heading">PANEL — MULTIPLE RENDERFRAGMENTS</div>
        </Header>
        <Body>
            <div class="panel-line">Body fragment · @_name</div>
            <div class="panel-line">Header, Body and Footer are separate RenderFragment parameters</div>
        </Body>
        <Footer>
            <div class="panel-line panel-foot">FOOTER FRAGMENT</div>
        </Footer>
    </Panel>

    <div class="footer">@pipelineLabel</div>
    
    <MyButton Value="Salut mec"></MyButton>
</div>

@code {
    
    private int _count;
    private string _name = "Type input here";
    private int _renderCount;

    protected override int BuildHash() => HashCode.Combine(_count, _name);

    protected override void OnAfterRender(bool firstRender)
    {
        _renderCount++;
    }

    private void Increment()
    {
        _count++;
    }

}
