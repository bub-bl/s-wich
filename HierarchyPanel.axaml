<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Crowbar"
             mc:Ignorable="d"
             x:Class="Crowbar.HierarchyPanel">
    <Border Background="#1F1F23" BorderBrush="#27272A" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto, *">
            <Border Grid.Row="0" Background="#27272A" Padding="10,6">
                <TextBlock Text="HIERARCHY" FontWeight="Bold" FontSize="11" Foreground="#A1A1AA" LetterSpacing="1"/>
            </Border>
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Scene.Objects, RelativeSource={RelativeSource AncestorType=local:HierarchyPanel}}"
                     SelectedItem="{Binding Scene.SelectedObject, RelativeSource={RelativeSource AncestorType=local:HierarchyPanel}, Mode=TwoWay}"
                     Background="Transparent" Margin="4">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:SceneObject">
                        <Border Padding="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="📦" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
