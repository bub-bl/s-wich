<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Crowbar"
             mc:Ignorable="d"
             x:Class="Crowbar.HierarchyPanel">
    <Border Background="#1F1F23" BorderBrush="#27272A" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto, *">
            <Border Grid.Row="0" Background="#27272A" Padding="10,6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="HIERARCHY" FontWeight="Bold" FontSize="11" Foreground="#A1A1AA" LetterSpacing="1"/>
                    <TextBlock Grid.Column="1" Text="⌄" FontSize="14" Foreground="#71717A" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <TreeView Grid.Row="1"
                      ItemsSource="{Binding TreeRoots, RelativeSource={RelativeSource AncestorType=local:HierarchyPanel}}"
                      SelectedItem="{Binding SelectedNode, RelativeSource={RelativeSource AncestorType=local:HierarchyPanel}, Mode=TwoWay}"
                      Background="Transparent"
                      BorderThickness="0"
                      Margin="4,6,4,4">
                <TreeView.Styles>
                    <Style Selector="TreeViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="MinHeight" Value="28"/>
                    </Style>
                    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapse">
                        <Setter Property="Foreground" Value="#71717A"/>
                        <Setter Property="Width" Value="18"/>
                    </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                    <TreeDataTemplate DataType="local:HierarchyNode" ItemsSource="{Binding Children}">
                        <Border Padding="5,4" CornerRadius="3">
                            <Grid ColumnDefinitions="20,*,Auto" MinWidth="210">
                                <TextBlock Text="{Binding Icon}" FontSize="13" Foreground="#F5B94C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#E4E4E7" VerticalAlignment="Center" FontWeight="Medium"/>
                                <CheckBox Grid.Column="2"
                                          IsVisible="{Binding HasVisibility}"
                                          IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                          Content="◉"
                                          FontSize="11"
                                          Foreground="#A1A1AA"
                                          Opacity="0.85"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
    </Border>
</UserControl>
